#!/usr/bin/env bash
# claudehut-state — the SOLE writer of ClaudeHut task state (schema 2; 04-routing-harness.md §3, ADR-R2).
# Hooks only READ state; this command is the only thing that writes it. Writes are atomic (temp + rename)
# and serialized by one advisory lock per plane.
#
#   state/<sid>.json        {"schema":2,"active_task":"<id>"|null}      — a pointer, nothing else
#   tasks/<id>/task.json    {"schema":2,"id","route","profile","phase","plan_approved","review",
#                            "plan_review_round","doc_schema","base":{repo:sha},"pre_dirty":{repo:[files]},
#                            "scope":[],"enforcement_set":[],"status","created",…artifact paths}
# A state or task file without "schema":2 (every v0.11 file, including the bypass=true ones) is NO task.
# A session that never runs `start` writes no state at all (the `direct` route).
#
# Usage:  claudehut-state [--session <sid>] <verb> [args]
#   --session defaults to $CLAUDEHUT_SESSION_ID (exported by the SessionStart hook through CLAUDE_ENV_FILE).
#
#   start --route light|full --slug <s> [--profile <p>] [--repo <path>]…   allocates the next NNNN under the
#                                     plane lock and creates tasks/NNNN-<s>/task.json; an open task of THIS
#                                     session becomes superseded (closed as done if it had finished). Prints the
#                                     task id (line 1) and its dir (line 2). One --repo per service: base and
#                                     pre_dirty per repo; ≥2 git toplevels → cross_service:true. The workspace/
#                                     hub plane is for cross-service tasks only (a notice, never a refusal).
#   set-route light|full              change the route
#   set-phase <discover|brainstorm|spec|plan|implement|review|learn> [--spec P] [--plan P]
#   set-reuse-scan --artifact P       (reuse-scan table must carry Fit/Impact + a decision)
#   set-brainstorm P | set-spec P     doclint gate (M3, 06 §4): a STRUCTURAL violation refuses (exit 1, nothing
#                                     written, one violation per line); budgets are printed, never enforced. The
#                                     same gate runs on set-plan, set-plan-review and set-phase --spec/--plan.
#   set-plan-review APPROVE|REVISE [--evidence P] [--user-decision "<text>"]
#                                     evidence defaults to tasks/<id>/plan-review.md; its one Verdict: line must match.
#                                     plan_review_round counts reviews, cap 2: after two rounds with the last one
#                                     REVISE, a third is refused until the user decides (AskUserQuestion) and it is
#                                     re-run with --user-decision — the text is stored and the round resets to 0.
#   set-plan P                        records the plan and sets plan_approved=true. Light route: P may be task.md.
#                                     Full route: a plan with ≥5 T-rows, a sensitive path in a T-row's Files cell,
#                                     or profile=migration needs a fresh plan-review APPROVE of the same bytes
#   set-review pass|pending|capped [--evidence P] [--override "<reason>"]
#                                     pass requires review.md evidence; then the kernel gate checks every cited
#                                     path:line resolves and no finding is open (claudehut-verify), and stores the
#                                     review binding (content fingerprint + spec/plan hash) for the end gate
#   set-enforcement --skills a,b --rules x.md,y.md | set-outstanding <json-array> | set-findings P
#   end --status done|abandoned [--override "<reason>"]
#                                     close the task; active_task=null. Invariant (0.12.7, gate engine): done needs
#                                     review pass|capped and, after a pass, an unchanged tree/spec/plan (the binding
#                                     stored at set-review pass). Gate mode warn (default) records and proceeds;
#                                     block refuses unless --override. Mode: $CLAUDEHUT_GATE_MODE > topology.json
#                                     .gates.mode > warn. Every outcome is an event in tasks/<id>/events.jsonl.
#   resume <id>                       attach an existing task to this session (new session or fork); the task is
#                                     then that session's: the previous owner's pointer is cleared, and every verb of
#                                     another session treats it as no task (a notice, nothing written, exit 0)
#   set-profile <p>                   set the open task's profile (feature|bugfix|audit|migration|investigation)
#   set-complexity trivial|small|full deprecated: set the open task's route (trivial/small → light, full → full)
#   status                            one-line JSON (read-only): the task's route, profile, phase, gates,
#                                     scope, enforcement_set and artifact paths — task.json is the only store
#   cost-report [--count]             read-only dispatch-ledger report (F6)
#
# Legacy verbs — M2 decision. 04-routing-harness.md §3 lists all of these as removed; each is kept, for this reason:
#   set-profile     a LIVE verb, no deprecation notice: skills/claudehut-workflow/SKILL.md tells the model to run it
#                   for a mid-flow shape change; `start --profile` covers only a new task.
#   set-complexity  deprecated: maps onto the route with a notice. No skill or agent runs it any more.
#   set-bypass, mark-skill, pause, rename, route
#                   removed in v0.12: accepted as no-ops with a one-line notice. No skill or agent runs them.
# None is deleted outright: an unknown verb exits 1, so deleting one would turn v0.11 skill text that is still
# installed (migrated planes, cached plugin copies) into hard errors mid-workflow. They are candidates for deletion
# with the 0.12.0 migration (M7), once no v0.11 text can reach them.
# With no active task, every verb except start and resume records nothing, prints a notice and exits 0
# (set-complexity, set-profile and set-phase discover included). Only `start` creates a task; nothing ever
# guesses one from the tasks/ listing. On a FINISHED open task (review pass / learn / findings), a new request's
# verbs (set-phase discover…, set-reuse-scan, set-spec, set-plan, a shape change via set-profile/set-route/
# set-complexity, and on a done task its review verbs) are the same no-op + notice; `start` opens the new task.
#
# Implementation (0.20 M1, docs/v0.20 04 §7 strangler): the Python kernel (scripts/kernel/claudehut_kernel/state.py)
# is the writer. The 0.12 bash writer stays at scripts/legacy/claudehut-state.sh for one release: it runs when
# CLAUDEHUT_STATE_IMPL=bash, when python3 is missing, fails to run or is older than 3.8, and for the read-only
# cost-report. The
# choice is made HERE, before anything is written; a transition is never retried with the other writer.
set -uo pipefail
CH_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# The interpreter is the kernel's (CLAUDEHUT_PYTHON, as bin/claudehut-kernel). It must actually RUN and be ≥3.8: a
# python3 that exists but fails (the macOS command-line-tools stub, a broken venv, a sandbox shim) would otherwise
# fail every verb — and an exit 1 reads to the model as "refused". One precheck fork per call; verbs are rare.
PY="${CLAUDEHUT_PYTHON:-python3}"
if [ "${CLAUDEHUT_STATE_IMPL:-py}" != bash ] && command -v "$PY" >/dev/null 2>&1 \
   && "$PY" -c 'import sys; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
  exec "$PY" -B "$CH_ROOT/scripts/kernel/state_cli.py" "$@"
fi
exec bash "$CH_ROOT/scripts/legacy/claudehut-state.sh" "$@"
