#!/usr/bin/env bash
# claudehut-worktree — deterministic lifecycle for the plugin's MANAGED agent worktrees.
# Managed root: ${CLAUDE_PROJECT_DIR:-$PWD}/.claude/worktrees  (where native `isolation: worktree` creates them).
# HARD SCOPE GUARD, stated as what is actually enforced (it used to claim more than it did):
#   sweep      — removes only worktrees whose realpath is under the managed root, and never runs a bare
#                destructive prune first, so user worktrees elsewhere can NEVER be touched.
#   reconcile  — merges only a LOCAL BRANCH (refs/heads/<b>); tags, remote-tracking refs and raw SHAs are
#                refused. It does not require the branch to still have a worktree: reconciling after a
#                sweep is legitimate.
#
# Usage:
#   claudehut-worktree status                          # list managed worktrees: branch, dirty?, merged?
#   claudehut-worktree check-disjoint <plan.md>        # [P] rows of the T-xxx table: exit 0 if Files are pairwise
#                                                      #   disjoint; exit 2 + the overlapping paths if not.
#   claudehut-worktree reconcile <branch> [--test-cmd CMD]
#                                                      # serialized merge of ONE agent branch into the current
#                                                      #   branch: refuses on dirty tree; --no-ff merge; on conflict
#                                                      #   aborts cleanly (exit 2); if CMD given, runs it and on
#                                                      #   failure resets the merge (exit 3). One branch per call —
#                                                      #   merge, test, then call again for the next (25-32% of
#                                                      #   parallel AI branches conflict; never batch-merge).
#   claudehut-worktree sweep                           # remove ONLY worktrees that are clean AND merged/unchanged
#                                                      #   (+ delete their branch), then prune stale metadata.
set -uo pipefail
err() { echo "claudehut-worktree: $*" >&2; exit 1; }
PROJ="${CLAUDE_PROJECT_DIR:-$PWD}"
cd "$PROJ" 2>/dev/null || err "cannot cd to project dir $PROJ"
git rev-parse --git-dir >/dev/null 2>&1 || err "not a git repository: $PROJ"
MROOT="$(cd "$PROJ" && pwd -P)/.claude/worktrees"

# scope guard: realpath of target must be strictly under MROOT
managed() { # $1 path -> 0 if under managed root
  local p; p="$(cd "$1" 2>/dev/null && pwd -P)" || return 1
  case "$p/" in "$MROOT"/*) return 0 ;; *) return 1 ;; esac
}

# managed worktree paths (from git's own registry, filtered to MROOT)
managed_list() {
  # The porcelain line is `worktree <path>` and the path may contain spaces — `~/My Projects/…` is an
  # ordinary macOS layout. Splitting on whitespace and taking $2 truncated such a path to its first word,
  # which then matched no directory, so the worktree vanished from BOTH `status` and `sweep`: the repo
  # looked empty and agent worktrees under it were never reported, let alone cleaned up. Take everything
  # after the 9-character "worktree " prefix instead.
  git worktree list --porcelain | awk '/^worktree /{print substr($0,10)}' | while read -r w; do
    case "$(cd "$w" 2>/dev/null && pwd -P)/" in "$MROOT"/*) echo "$w" ;; esac
  done
}

wt_branch() { git -C "$1" rev-parse --abbrev-ref HEAD 2>/dev/null; }
wt_dirty()  { [ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]; }
wt_merged() { # $1 = worktree path, $2 = branch name. True only when the worktree's OWN tip is reachable.
  # DATA LOSS FIX. This used to take only the branch NAME and resolve it with `git rev-parse "$b"` in the
  # MAIN repo. A detached-HEAD worktree reports its branch as the literal string "HEAD", so that resolved
  # to the MAIN repo's HEAD and the next line asked "is main's HEAD an ancestor of main's HEAD" — trivially
  # true. Every detached worktree therefore looked merged, and sweep removed it. Committed agent work in
  # such a worktree has no branch pointing at it, so removal left the commits unreachable: reproduced, then
  # `git cat-file` could not recover the content. The message printed alongside it read
  # "kept = dirty or unmerged", which is the opposite of what happened.
  local w="$1" b="$2" tip
  # Resolve the tip INSIDE the worktree, never by name in the main repo.
  tip="$(git -C "$w" rev-parse HEAD 2>/dev/null)" || return 1
  [ -n "$tip" ] || return 1
  # A detached worktree has no branch to merge into anything. Never auto-remove it: there is no ref that
  # would survive, so "unmerged" is the only safe reading.
  [ "$b" = "HEAD" ] && return 1
  git merge-base --is-ancestor "$tip" HEAD 2>/dev/null
}

sub="${1:-}"; shift || true
case "$sub" in
  status)
    found=false
    while read -r w; do
      [ -n "$w" ] || continue; found=true
      b="$(wt_branch "$w")"; d="clean"; wt_dirty "$w" && d="DIRTY"
      m="unmerged"; wt_merged "$w" "$b" && m="merged"
      [ "$b" = "HEAD" ] && m="DETACHED (never auto-removed)"
      echo "$w  branch=$b  $d  $m"
    done <<<"$(managed_list)"
    $found || echo "(no managed worktrees under .claude/worktrees/)"
    ;;

  check-disjoint)
    plan="${1:-}"; [ -f "$plan" ] || err "check-disjoint needs <plan.md>"
    # PHASE-AWARE. The main thread fans out [P] tasks WITHIN a phase, so disjointness is checked
    # per-phase: two [P] tasks in DIFFERENT phases may legitimately touch the same file (e.g. a domain
    # phase creates a service, a later cross-cutting phase edits it) — they never run concurrently, so a
    # global check would falsely serialize them. Phases are the plan's markdown/bold "Phase N" headings;
    # a plan with no phase headings is one implicit phase 0 (== the old global behavior). Files = 4th
    # cell; the leading [PG]/[P] annotations have no "/" and drop out, backticks are stripped.
    # The phase key is the LABEL as written in the heading ("1", "3", "A"), not a sequence counter. The
    # counter renumbered a plan whose phases were 1 and 3 into "phase 1" and "phase 2", so the tool named a
    # phase the plan does not contain. It also has to be shared: all three passes below key on this value,
    # and the schedule pass looks phases up in the sets the other two produce, so the computation is defined
    # ONCE here and textually prefixed to each program rather than copied three times.
    PHASE_RULE='
      BEGIN { phase = "0" }   # rows before the first heading land in phase 0 (not key "")
      $0 !~ /^[[:space:]]*\|/ && $0 ~ /[Pp]hase[[:space:]]+[0-9A-Za-z]/ && ($0 ~ /#/ || $0 ~ /\*\*/) {
        match($0, /[Pp]hase[[:space:]]+[0-9A-Za-z]+/); lab = substr($0, RSTART, RLENGTH)
        sub(/^[Pp]hase[[:space:]]+/, "", lab); phase = lab; next }
'
    # Pass 1 — (phase, path) pairs for the file-overlap check.
    pairs="$(awk -F'|' "$PHASE_RULE"'
      $2 ~ /T-[0-9]+/ && $2 ~ /\[P\]/ {
        match($2, /T-[0-9]+/); id = substr($2, RSTART, RLENGTH)
        n=split($4, f, /[,[:space:]]+/)
        for (i=1;i<=n;i++) { p=f[i]; gsub(/`/,"",p); gsub(/[)(,;]+$/,"",p)
          # A path was recognised by "contains a /". That dropped the [P] annotation as intended, and ALSO
          # dropped every repo-root file — pom.xml, build.gradle, build.gradle.kts, settings.gradle — which
          # is exactly what a "add dependency X" task edits, and exactly where two [P] tasks collide.
          # Reproduced: two [P] tasks both listing pom.xml were reported as a safe PARALLEL BATCH.
          # Recognise a FILE instead: a dotted extension, optionally nested. Prose cells ("—", "_(migration)_")
          # and the annotation carry no such token and still drop out.
          if (p ~ /^[A-Za-z0-9_.@+-]+(\/[A-Za-z0-9_.@+-]+)*\.[A-Za-z0-9]+$/) {
            # A path listed TWICE inside ONE task cell is not a cross-task collision, but `sort | uniq -d`
            # cannot tell same-task from cross-task and reported it as an OVERLAP — a false positive that
            # serialized a phase that was in fact parallel-safe. Key on the TASK too and emit each
            # (phase, task, path) once, so only a genuine second OWNER of a path survives into uniq -d.
            k = phase SUBSEP id SUBSEP p
            if (!(k in emitted)) { emitted[k] = 1; print phase "\t" p } }
          }
      }' "$plan")"
    overlaps="$(printf '%s\n' "$pairs" | grep -v '^$' | sort | uniq -d)"
    # Pass 2 — the OTHER half of what [P] means. plan-template.md: "[P] = no dependency on another task in
    # the SAME phase AND disjoint Files". Only the Files half was ever checked; the Depends-on cell ($8) was
    # never read, so a planner that marked a task [P] while it declared a dependency on a sibling [P] task
    # got both dispatched concurrently — a task running alongside its own stated prerequisite. Narrow on
    # purpose: it fires only when the named task is in the SAME phase AND is itself [P]. A cross-phase
    # dependency is normal (the template's own Phase 1 depends on Phase 0), and a dependency on a
    # same-phase NON-[P] task is left alone. The cell is free text ("—", "T-001, T-003", "T-001 (partial)"),
    # so match permissively: scan it for T-xxx tokens and intersect with that phase's [P] id set.
    depviol="$(awk -F'|' "$PHASE_RULE"'
      $2 ~ /T-[0-9]+/ && $2 ~ /\[P\]/ {
        match($2, /T-[0-9]+/); id = substr($2, RSTART, RLENGTH)
        pset[phase SUBSEP id] = 1
        if (!(phase in seen)) { seen[phase] = 1; order[++k] = phase }
        ids[phase, ++cnt[phase]] = id; dep[phase SUBSEP id] = $8 }
      END { for (i=1;i<=k;i++) { p = order[i]
              for (j=1;j<=cnt[p];j++) { id = ids[p,j]; s = dep[p SUBSEP id]
                while (match(s, /T-[0-9]+/)) { t = substr(s, RSTART, RLENGTH); s = substr(s, RSTART+RLENGTH)
                  if (t != id && ((p SUBSEP t) in pset)) print p "\t" id "\t" t } } } }
    ' "$plan")"
    unsafe_ovl="$(printf '%s\n' "$overlaps" | grep -v '^$' | cut -f1 | sort -u | tr '\n' ' ')"
    unsafe_dep="$(printf '%s\n' "$depviol"  | grep -v '^$' | cut -f1 | sort -u | tr '\n' ' ')"
    # Pass 3 — the per-phase dispatch schedule, the deterministic plan the implement skill follows.
    # It now knows which phases are unsafe. It used to be built with no knowledge of the overlaps at all, so
    # on the exit-2 path the offending phase was still printed as a normal "PARALLEL BATCH [...]" line,
    # byte-identical to a safe one, under a caption asking the reader to cross-reference and subtract —
    # against orchestration.md:32, which says to follow this schedule and not re-derive batches by eye.
    # An unsafe phase now carries the word SEQUENTIAL and never the string PARALLEL BATCH.
    schedule="$(awk -F'|' -v uo="$unsafe_ovl" -v ud="$unsafe_dep" "$PHASE_RULE"'
      BEGIN { n = split(uo, a, " "); for (i=1;i<=n;i++) if (a[i] != "") O[a[i]] = 1
              n = split(ud, a, " "); for (i=1;i<=n;i++) if (a[i] != "") D[a[i]] = 1
              MAXW = 3 }   # orchestration.md:37 — "max 3 concurrent; a larger batch fans out in successive messages of <=3"
      $2 ~ /T-[0-9]+/ && $2 ~ /\[P\]/ { match($2,/T-[0-9]+/); id=substr($2,RSTART,RLENGTH)
        if (!(phase in seen)) { seen[phase] = 1; order[++k] = phase }
        ids[phase, ++cnt[phase]] = id }
      END { for (i=1;i<=k;i++) { p = order[i]; n = cnt[p]; all = ""
              for (j=1;j<=n;j++) all = all (j>1 ? ", " : "") ids[p,j]
              if ((p in O) && (p in D)) { print "  phase " p ": SEQUENTIAL (overlap + dependency) [" all "]"; continue }
              if (p in O) { print "  phase " p ": SEQUENTIAL (overlap) [" all "]"; continue }
              if (p in D) { print "  phase " p ": SEQUENTIAL (dependency) [" all "]"; continue }
              if (n == 1) { print "  phase " p ": [" all "] (lone [P] — no batch)"; continue }
              # The schedule used to emit one unbounded PARALLEL BATCH line however many [P] tasks a phase
              # had, while orchestration.md caps live dispatch at 3 — so a 6-task phase handed the model a
              # batch it had to re-chunk by eye, the exact thing it is told not to do. Chunk it here.
              # A phase that fits in one wave keeps the original unsuffixed line; only a genuinely
              # multi-wave phase gains the "w/total" marker.
              waves = int((n + MAXW - 1) / MAXW)
              for (w=1;w<=waves;w++) { lo = (w-1)*MAXW + 1; hi = lo + MAXW - 1; if (hi > n) hi = n
                batch = ""
                for (j=lo;j<=hi;j++) batch = batch (j>lo ? ", " : "") ids[p,j]
                if (waves == 1) print "  phase " p ": PARALLEL BATCH [" batch "]"
                else            print "  phase " p ": PARALLEL BATCH " w "/" waves " [" batch "]" } } }
    ' "$plan")"
    if [ -n "$overlaps" ] || [ -n "$depviol" ]; then
      [ -n "$overlaps" ] && {
        echo "OVERLAP — these paths appear in more than one [P] task WITHIN the same phase (that phase's parallel dispatch is UNSAFE; run those tasks sequentially):"
        printf '%s\n' "$overlaps" | sed 's/^/  phase /; s/\t/ : /'; }
      [ -n "$depviol" ] && {
        echo "DEPENDENCY — these [P] tasks declare a dependency on another [P] task in the SAME phase, so they cannot run concurrently (drop the [P], or move the dependency to an earlier phase):"
        printf '%s\n' "$depviol" | awk -F'\t' '{print "  phase " $1 " : " $2 " depends on " $3}'; }
      [ -n "$schedule" ] && { echo "per-phase [P] schedule (a phase marked SEQUENTIAL is NOT parallel-safe — run its tasks in order):"; echo "$schedule"; }
      exit 2
    fi
    if [ -n "$schedule" ]; then
      echo "disjoint: every phase's [P] Files are pairwise distinct and no [P] task depends on a [P] sibling — per-phase parallel dispatch is safe. Schedule:"
      echo "$schedule"
    else
      echo "disjoint: no [P] tasks found — nothing to parallelize (dispatch sequentially / inline)."
    fi
    ;;

  reconcile)
    b="${1:-}"; [ -n "$b" ] || err "reconcile needs <branch>"; shift || true
    # Track whether the flag was PRESENT separately from its value. `--test-cmd ""` (an unset variable
    # interpolated by the caller) used to collapse into the same empty $tcmd as "no flag at all": the branch
    # was merged, no test ever ran, and the success line was byte-identical to an untested merge. The caller
    # asked for verification and got none, silently. Refuse it, and refuse it BEFORE the merge — erroring
    # afterwards would leave the merge in place, which is the state we are trying to prevent.
    tcmd=""; have_tcmd=false
    [ "${1:-}" = "--test-cmd" ] && { have_tcmd=true; tcmd="${2:-}"; }
    $have_tcmd && [ -z "$tcmd" ] && err "--test-cmd was given an empty command — refusing to merge $b unverified (omit the flag entirely to merge without tests)"
    # `git rev-parse --verify "$b"` resolves ANY committish, so `reconcile` — the one mutating operation
    # with no scope check of its own — would happily `merge --no-ff` a tag, a remote-tracking ref or a raw
    # SHA into the current branch, which the header advertised as impossible. Resolve under refs/heads/
    # only: the documented argument is <branch>, and an agent branch is always a local branch.
    git rev-parse --verify --quiet "refs/heads/$b" >/dev/null 2>&1 \
      || err "not a local branch: $b (reconcile merges agent BRANCHES only — tags, remote refs and raw SHAs are refused)"
    # tracked modifications only — the managed worktree dirs themselves are untracked under .claude/,
    # and git merge already refuses to clobber untracked files.
    [ -z "$(git status --porcelain --untracked-files=no)" ] || err "main tree has uncommitted tracked changes — commit or stash before reconciling"
    if ! git merge --no-ff "$b" -m "claudehut: reconcile agent branch $b" >/dev/null 2>&1; then
      git merge --abort >/dev/null 2>&1 || true
      echo "CONFLICT merging $b — merge aborted, tree restored. Resolve manually or re-plan the task." >&2
      exit 2
    fi
    if [ -n "$tcmd" ]; then
      if ! bash -c "$tcmd"; then
        git reset --hard ORIG_HEAD >/dev/null 2>&1
        echo "TESTS RED after merging $b — merge rolled back (ORIG_HEAD). Fix in the agent branch, then reconcile again." >&2
        exit 3
      fi
    fi
    # Say which of the two happened. "reconciled: x merged." read as success in both cases; the untested
    # one now names itself so a green line is never mistaken for a verified merge.
    echo "reconciled: $b merged$( [ -n "$tcmd" ] && echo " (tests green)" || echo " (NO --test-cmd given — nothing was verified)" )."
    ;;

  sweep)
    removed=0; kept=0
    while read -r w; do
      [ -n "$w" ] || continue
      managed "$w" || { echo "skip (outside managed root — guard): $w"; kept=$((kept+1)); continue; }
      b="$(wt_branch "$w")"
      if wt_dirty "$w"; then echo "keep (DIRTY — uncommitted agent work, reconcile or inspect first): $w"; kept=$((kept+1)); continue; fi
      if ! wt_merged "$w" "$b"; then
        if [ "$b" = "HEAD" ]; then
          echo "keep (DETACHED HEAD — commits here are on no branch and would be unrecoverable): $w"
        else
          echo "keep (branch $b not merged — reconcile first): $w"
        fi
        kept=$((kept+1)); continue
      fi
      git worktree remove "$w" >/dev/null 2>&1 || { echo "keep (git refused remove): $w"; kept=$((kept+1)); continue; }
      [ -n "$b" ] && [ "$b" != "HEAD" ] && git branch -d "$b" >/dev/null 2>&1 || true
      echo "removed: $w (branch $b)"; removed=$((removed+1))
    done <<<"$(managed_list)"
    git worktree prune >/dev/null 2>&1 || true   # metadata only — runs AFTER scoped removals
    echo "sweep: removed=$removed kept=$kept (kept = dirty or unmerged; nothing outside .claude/worktrees/ touched)"
    ;;

  *) err "unknown subcommand: ${sub:-<none>} (status|check-disjoint|reconcile|sweep)" ;;
esac
