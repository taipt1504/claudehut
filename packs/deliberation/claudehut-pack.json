{
  "$schema": "../claudehut-pack.schema.json",
  "pack": "deliberation",
  "version": "0.20.0-dev.2",
  "kernel": "~0.20",
  "kind": "quality",
  "description": "Design deliberation: tier, variation probe, two-way Protected Variation rule, decision record, design-reviewer, opt-in T3 tournament (appendix a2).",
  "detect": {
    "always": true
  },
  "owns": [
    "skills/deliberate/**",
    "agents/claudehut-design-reviewer.md",
    "agents/claudehut-tournament-judge.md"
  ],
  "guides": [],
  "sensors": [
    {"id": "vendor-leak", "run": "claudehut-verify vendor-leak", "mode": "advisory"}
  ],
  "invariants": [
    {"id": "plan.tier-needs-decision", "at": "set-plan", "mode": "warn"}
  ],
  "evals": [
    "evals/suites/decision/*"
  ]
}
