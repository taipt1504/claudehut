{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/maintain.sh\"", "async": true }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/inject-phase.sh\"", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/advise-write.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/record-agent-dispatch.sh\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "if": "Write(*.java)", "statusMessage": "formatting Java", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/format-java.sh\"", "async": true },
          { "type": "command", "if": "Edit(*.java)",  "statusMessage": "formatting Java", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/format-java.sh\"", "async": true },
          { "type": "command", "if": "Write(*.java)", "statusMessage": "checking reuse",  "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/lint-reuse.sh\"",  "async": true },
          { "type": "command", "if": "Edit(*.java)",  "statusMessage": "checking reuse",  "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/lint-reuse.sh\"",  "async": true },
          { "type": "command", "if": "Write(*.md)", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/doclint-advise.sh\"", "timeout": 5 },
          { "type": "command", "if": "Edit(*.md)",  "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/doclint-advise.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hint-explore.sh\"", "timeout": 2 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/record-failure.sh\"", "async": true }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/record-dispatch.sh\"", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/verify-subagent.sh\"", "async": true }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/record-rules-loaded.sh\"", "async": true }
        ]
      }
    ]
  }
}
